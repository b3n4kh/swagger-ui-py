                                    ]
                                }
                            },
                            "then": {
                                "$ref": "#/definitions/bindings-amqp-0.3.0-channel"
                            }
                        },
                        {
                            "if": {
                                "required": [
                                    "bindingVersion"
                                ],
                                "properties": {
                                    "bindingVersion": {
                                        "const": "0.3.0"
                                    }
                                }
                            },
                            "then": {
                                "$ref": "#/definitions/bindings-amqp-0.3.0-channel"
                            }
                        }
                    ],
                    "properties": {
